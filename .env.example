# Docker Compose reads .env automatically. Replace the placeholder with a random hex password.
DB_PASSWORD=replace-with-a-random-hex-password
PUBLIC_ORIGIN=http://localhost:8080
# DOMAIN=bunker.example.com
# APP_PORT=8080

# Native Node development does not load .env automatically.
# Without DATABASE_URL use atomic JSON saves in ./data (development only).
# DATABASE_URL=postgresql://bunker:YOUR_HEX_PASSWORD@localhost:5432/bunker?schema=public
PORT=3001
HOST=0.0.0.0

# Native npm run dev prefers these ports and automatically chooses free ones.
# CLIENT_PORT=5173
# npm run share optionally uses an official cloudflared binary outside PATH.
# CLOUDFLARED_PATH=/absolute/path/to/cloudflared
